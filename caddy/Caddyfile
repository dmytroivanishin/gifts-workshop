# Public entry point. Caddy obtains and renews the TLS certificate itself (Let's Encrypt).
# The site address is NEXT_PUBLIC_APP_URL from config/.env, e.g. https://handmade.com.
# Ports 80 and 443 must be open and DNS must point to the server before the first start.

{
	# A client that sends a request body slower than this (or stalls) is disconnected, so the upload
	# never holds the app's memory for longer than a minute. Covers the upload body, not the response.
	servers {
		timeouts {
			read_body 60s
		}
	}
}

{$NEXT_PUBLIC_APP_URL} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# Media: the folder the app writes to, served straight from disk (/srv/media is the host ./media).
	# handle_path strips /static/media, so /static/media/<bucket>/<key> maps to /srv/media/<bucket>/<key>.
	# S3_PUBLIC_URL in config/.env is <site>/static/media.
	handle_path /static/media/* {
		# Dot-files are temporary writes, never served.
		@hidden path_regexp hidden (^|/)\.
		respond @hidden 404

		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
