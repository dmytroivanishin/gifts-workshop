# TEMPLATE. The real config/.env on the server is written by .github/workflows/deploy.yml from
# GitHub secrets and variables; never commit real values. Copy this to config/.env only for a
# manual run. Lines marked `derived` are built by the workflow, not set by hand.

# ----- Public (also baked into the image at build time) -----
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,en
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_DEFAULT_LOCALE_PUBLIC=en
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_MAX_FILES_PER_UPLOAD=30
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_SOCIAL_LINKS=[]

# ----- Media (files in ./media on the server, served by Caddy under /static/media) -----
MEDIA_THUMBNAIL_MAX_PX=320
MEDIA_PREVIEW_MAX_PX=1000
S3_BUCKET_NAME=gifts-workshop-media                      # the folder name under ./media
S3_PUBLIC_URL=https://your-domain.example/static/media   # derived: NEXT_PUBLIC_APP_URL + /static/media

# ----- Database -----
DB_URI=postgresql://USER:PASSWORD@postgres:5432/gifts_workshop   # derived from POSTGRES_* below

# ----- Auth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@example.com
JWT_SECRET=                          # openssl rand -base64 48

# ----- Site texts (server-only) -----
SITE_TITLE_RU=
SITE_TITLE_EN=
SITE_TEMPLATE_RU=
SITE_TEMPLATE_EN=
SITE_DESCRIPTION_RU=
SITE_DESCRIPTION_EN=
SITE_KEYWORDS_RU=
SITE_KEYWORDS_EN=
SITE_NAME_RU=
SITE_NAME_EN=

# ----- Compose only: Postgres container -----
POSTGRES_DB=gifts_workshop
POSTGRES_USER=
POSTGRES_PASSWORD=                   # hex only (goes into DB_URI unescaped)

# ----- GitHub Actions: deploy access (secret). Set in the repository settings, empty here on purpose -----
# Read by .github/workflows/deploy.yml. Not read from this file.
VPS_HOST="203.0.113.10"
VPS_USER="deploy"
VPS_SSH_KEY=""           # whole private key, including the BEGIN/END lines
VPS_KNOWN_HOSTS=""       # output of: ssh-keyscan -H <VPS_HOST>
