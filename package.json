{
  "name": "next-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "local:infra:start": "docker-compose -f docker-compose.local.yml up -d",
    "media:reconcile": "tsx scripts/reconcile-media.ts",
    "local:infra:stop": "docker-compose -f docker-compose.local.yml down",
    "test:infra:start": "docker-compose -p gift_workshop_test -f docker-compose.test.yml up -d && sleep 5 && npx drizzle-kit push",
    "test:infra:stop": "docker-compose -p gift_workshop_test -f docker-compose.test.yml down",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "rm -rf .next/dev/cache/fetch-cache && playwright test --project=e2e --workers=1",
    "test:e2e:ui": "rm -rf .next/dev/cache/fetch-cache && playwright test --project=e2e --ui",
    "test:api": "playwright test --project=api",
    "test:api:ui": "playwright test --project=api --ui",
    "migrate": "tsx src/migrations/migrate.ts",
    "migrate:verify": "tsx src/migrations/verify-schema.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-virtual": "^3.14.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "minio": "^8.0.7",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "^11.2.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "react-icons": "^5.6.0",
    "react-redux": "^9.3.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.8",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "node-mocks-http": "^1.17.2",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
