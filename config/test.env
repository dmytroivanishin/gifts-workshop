# PostgreSQL Database Configuration for Tests
DB_URI="postgresql://test_user:test_password@127.0.0.1:5433/test_gift_workshop"

# S3 Media Storage (isolated test-minio service, docker-compose.test.yml — NOT the dev MinIO on 9000/9001)
S3_ENDPOINT="http://localhost:9002"
S3_PUBLIC_URL="http://localhost:9002"
S3_ACCESS_KEY="test_minio_admin"
S3_SECRET_KEY="test_minio_password"
S3_BUCKET_NAME="gift-workshop-media-test"

# Google Login (Copied from your base .env)
GOOGLE_CLIENT_ID="mock_google_client_id"
GOOGLE_CLIENT_SECRET="mock_google_client_secret"
ADMIN_EMAILS="admin@admin.com"

# Media Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE_MB="10"
MEDIA_THUMBNAIL_MAX_PX="320"
MEDIA_PREVIEW_MAX_PX="1000"

# Signing secret for test-run JWTs (mock value, not the real dev/prod secret)
JWT_SECRET="mock_test_jwt_secret_do_not_use_in_prod"

# Default Locales
NEXT_PUBLIC_SUPPORTED_LOCALES="ru,en"
NEXT_PUBLIC_DEFAULT_LOCALE="ru"

# Public App URL for SEO and OG Tags
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Global SEO Metadata
SITE_TITLE_RU="Мастерская подарков | Каталог душевной ручной работы"
SITE_TITLE_EN="Gifts Workshop | Soulful Handmade Catalog"
SITE_TEMPLATE_RU="%s | Мастерская подарков"
SITE_TEMPLATE_EN="%s | Gifts Workshop"
SITE_DESCRIPTION_RU="Мастерская подарков — каталог душевной ручной работы. Уют на кухне: авторский текстиль, прихваточки, варежки и полотенца. Интерьерные куколки и мягкие плюшевые игрушки. Радость в деталях для любимого дома."
SITE_DESCRIPTION_EN="Gifts Workshop — soulful handmade catalog. Kitchen textiles, potholders, oven mitts, and towels. Interior dolls and plush toys. Joy in details for your beloved home."
SITE_KEYWORDS_RU="ручная работа, подарки ручной работы, каталог handmade, текстиль для кухни, прихватки, варежки, полотенца, интерьерные куклы, плюшевые игрушки, уют в доме, Мастерская подарков"
SITE_KEYWORDS_EN="handmade, handmade gifts, handmade catalog, kitchen textiles, potholders, oven mitts, towels, interior dolls, plush toys, home coziness, Gifts Workshop"
SITE_NAME_RU="Мастерская подарков"
SITE_NAME_EN="Gifts Workshop"
NEXT_PUBLIC_DEV_MODE="true"
NEXT_PUBLIC_SOCIAL_LINKS='[{ "name": "Pinterest", "link": "", "icon": "pinterest" }, {"name":"Telegram","link":"https://t.me/dmytro_petrenko","icon":"telegram"},{"name":"Instagram","link":"https://www.instagram.com/dmytro-petrenko","icon":"instagram"},{"name":"VK","link":"https://www.vk.com/dmytro-petrenko","icon":"vk"},{"name":"Email","link":"mailto:dmytroivanishin@gmail.com","icon":"email"}]'

# Public read rate limit: the whole e2e/API suite runs from one address, so lift the production default (120/min)
RATE_LIMIT_PUBLIC_READ_PER_MINUTE="1000"
